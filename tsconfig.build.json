{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "allowImportingTsExtensions": false
    },
    "include": ["src/**/*.ts", "src/**/*.vue"],
    "exclude": ["demo", "dist", "dist-demo"]
}
