{
    "name": "markdownit-vue-render",
    "version": "0.1.0",
    "description": "Vue 3 markdown-it renderer with customizable token tree rendering",
    "type": "module",
    "main": "./dist/markdownit-vue-render.cjs",
    "module": "./dist/markdownit-vue-render.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/markdownit-vue-render.mjs",
            "require": "./dist/markdownit-vue-render.cjs",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "bun --bun vite dev",
        "build": "bun --bun vite build",
        "build:lib": "bun --bun vite build --mode lib",
        "build:demo": "bun --bun vite build --mode demo",
        "build:types": "bunx vue-tsc -p tsconfig.build.json",
        "preview": "bun --bun vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "echo 'No linter configured'",
        "format": "echo 'No formatter configured'",
        "prepublishOnly": "bun run build:lib && bun run build:types"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "dependencies": {
        "markdown-it": "^14.1.0",
        "markdown-it-cjk-friendly": "^1.2.0"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/lodash-es": "^4.17.12",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^20.0.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "less": "^4.2.0",
        "lodash-es": "^4.17.21",
        "typescript": "^5.4.0",
        "vant": "^4.9.0",
        "vite": "^5.2.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ChinaLiuxiaosong/markdownit-vue-render.git"
    },
    "homepage": "https://chinaliuxiaosong.github.io/markdownit-vue-render/",
    "bugs": {
        "url": "https://github.com/ChinaLiuxiaosong/markdownit-vue-render/issues"
    },
    "keywords": [
        "vue",
        "vue3",
        "markdown-it",
        "markdown",
        "renderer",
        "token-tree",
        "plugin"
    ],
    "license": "MIT",
    "packageManager": "bun@1.1.0"
}
